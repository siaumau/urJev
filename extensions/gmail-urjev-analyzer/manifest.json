{
  "manifest_version": 3,
  "name": "urJev Gmail 郵件分析器",
  "version": "0.2.0",
  "description": "使用本機 urJev 分析 Gmail 郵件，確認後整理到 AI 分類標籤。",
  "minimum_chrome_version": "105",
  "permissions": ["identity", "storage", "clipboardWrite"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "urJev Gmail 分析器",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "oauth2": {
    "client_id": "428669245002-efjblin243e4fov490562uu7vst24ovc.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.modify"]
  }
}
