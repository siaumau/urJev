PORT=15413
INFERENCE_BACKEND=vllm
VLLM_URL=http://127.0.0.1:18000
MODEL=Qwen/Qwen3-4B-Instruct-2507
# Use `npm run model:select:8b` to switch this to Qwen/Qwen3-8B.
INFERENCE_TIMEOUT_MS=120000
SENTIMENT_STRATEGY=auto
# auto: Qwen3-8B uses two binary decisions for the validated four-class sentiment definition.
# direct: restore the original single-label path; restart the web/API service after changing.

# Optional exact public HTTPS origin when using a reverse proxy.
# PUBLIC_ORIGIN=https://jev.example.com

# Optional comma-separated Chrome extension origins allowed to call the local API.
# EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
